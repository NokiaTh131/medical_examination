generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model MEX {
  id            Int     @id @default(autoincrement())
  docID         String       
  hn            Int
  chiefComplaint String
  presentHistory String
  examination_filename String
  dx            String
  procedure     Json
  appointment   Json?
  date          DateTime  @default(now())

  RxList   RxList[]
  patientRecord patientRecord[]
}

model RxList {
  id          Int     @id @default(autoincrement())
  medicalName String
  quantity    Int
  use         String
  note        String?
  unit        String

  MEX MEX @relation(fields: [mexId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  mexId Int
}


model patientRecord {
  id          Int     @id @default(autoincrement())
  bloodPressure String
  pulse         String
  temperature    Float
  respiratoryRate  Float
  MEX MEX @relation(fields: [mexId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  mexId Int
}