                          "description": "The patient's blood pressure.",
                          "example": "120/80"
                        },
                        "temperature": {
                          "type": "string",
                          "description": "The patient's temperature.",
                          "example": "36.6"
                        },
                        "respiratoryRate": {
                          "type": "integer",
                          "description": "The patient's respiratory rate.",
